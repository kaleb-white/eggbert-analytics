{
    "name": "cpp-cache",
    "private": true,
    "scripts": {
        "debug-build-cli": "gcc -o ./cli_cache.exe ./main_cli.cpp ./lru/lru_map_and_linked_list.cpp ./comand_line_parser/command_line_parser_impl.cpp ./input_parser/input_parser_impl.cpp ./headers/utils/string_utils.cpp -I./headers -lstdc++ -O0 -pedantic-errors -Wall -Weffc++ -Wextra -Wconversion -Werror -std=c++17",
        "build-cli": "gcc -o ./cli_cache.exe main.cpp ./lru/lru.o ./comand_line_parser/command_line_parser.o ./input_parser/input_parser.o -I./headers -O2 -lstdc++ -pedantic-errors -Wall -Weffc++ -Wextra -Wconversion -Werror -std=c++17",
        "socket-build": "gcc -o ./socket_cache.exe main_windows_socket.cpp ./headers/utils/string_utils.o ./lru/lru.o ./comand_line_parser/command_line_parser.o ./input_parser/input_parser.o -I./headers -O3 -DNDEBUG -lstdc++ -pedantic-errors -Wall -Weffc++ -Wextra -Wconversion -Werror -std=c++17 -lws2_32 -lwsock32",
        "socket-build-all": "bun run string-utils-object && bun run input-parser-object && bun run cl-parser-object && bun run lru-object && bun run socket-build",
        "socket-cache": "./socket_cache.exe",
        "socket-cache-verbose": "./socket_cache.exe -v=1",
        "socket-cache-timed": "./socket_cache.exe -t=1",
        "socket-cache-timed-verbose": "./socket_cache.exe -v=1 -t=1",
        "socket-test-build": "gcc -o ./main_tests/socket_cache_test.exe ./main_tests/main_windows_socket.test.cpp -I./headers -O2 -lstdc++ -pedantic-errors -Wall -Weffc++ -Wextra -Wconversion -Werror -std=c++17 -lws2_32 -lwsock32",
        "socket-test": "./main_tests/socket_cache_test.exe",
        "cli-cache": "./cli_cache.exe",
        "cli-cache-verbose": "./cli_cache.exe -v=1",
        "lru-test-compile": "gcc -o ./lru/lru.test.exe ./lru/lru.test.cpp -I./headers -O0 -lstdc++ -DNDEBUG",
        "lru-test": "./lru/lru.test.exe",
        "lru-object": "gcc -c lru/lru_map_and_linked_list.cpp -o lru/lru.o -I./headers -O3 -lstdc++ -DNDEBUG -pedantic-errors -Wall -Weffc++ -Wextra -Wconversion -Werror -std=c++17",
        "cl-parser-test-compile": "gcc -o ./comand_line_parser/command_line_parser_impl.test.exe ./comand_line_parser/command_line_parser_impl.cpp ./comand_line_parser/command_line_parser_impl.test.cpp -I./headers -O0 -lstdc++ -DNDEBUG",
        "cl-parser-test": "./comand_line_parser/command_line_parser_impl.test.exe",
        "cl-parser-object": "gcc -c comand_line_parser/command_line_parser_impl.cpp -o ./comand_line_parser/command_line_parser.o -I./headers -O3 -lstdc++ -DNDEBUG -pedantic-errors -Wall -Weffc++ -Wextra -Wconversion -Werror -std=c++17",
        "input-parser-test-compile": "gcc -o ./input_parser/input_parser_impl.test.exe ./input_parser/input_parser_impl.test.cpp ./input_parser/input_parser_impl.cpp ./headers/utils/string_utils.o -I./headers -O0 -lstdc++ -DNDEBUG -pedantic-errors -Wall -Weffc++ -Wextra -Wconversion -Werror -std=c++17",
        "input-parser-test": "./input_parser/input_parser_impl.test.exe",
        "input-parser-object": "gcc -c input_parser/input_parser_impl.cpp -o input_parser/input_parser.o -I./headers -O3 -lstdc++ -DNDEBUG -pedantic-errors -Wall -Weffc++ -Wextra -Wconversion -Werror -std=c++17",
        "string-utils-object": "gcc -c headers/utils/string_utils.cpp -o headers/utils/string_utils.o -I./headers -O3 -lstdc++ -DNDEBUG -pedantic-errors -Wall -Weffc++ -Wextra -Wconversion -Werror -std=c++17"
    }
}
